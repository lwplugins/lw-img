#: includes/Bulk/BulkActions.php:64
#, php-format
msgid "Bulk optimization started: %s image queued."
msgid_plural "Bulk optimization started: %s images queued."
msgstr[0] "Tömeges optimalizálás elindítva: %s kép sorba állítva."
msgstr[1] "Tömeges optimalizálás elindítva: %s kép sorba állítva."

#: includes/Bulk/BulkActions.php:84
msgid "The run was cancelled. Images converted so far stay converted."
msgstr "A futás megszakítva. Az eddig konvertált képek konvertálva maradnak."

#: includes/Bulk/BulkActions.php:85
msgid "No run is in progress."
msgstr "Nincs folyamatban futás."

